{
  "name": "xiv-quest-tree",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FINAL FANTASY XIV quest dependency tree — trilingual, filterable, zoomable",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node tools/logic-test.mjs",
    "test:dom": "vite build --config tools/vite.iife.config.ts && node tools/dom-smoke.mjs",
    "verify:strings": "node tools/verify-ffcafe.mjs",
    "graph:ascii": "node tools/layout-ascii.mjs",
    "icons:fetch": "node tools/fetch-icons.mjs",
    "icons:view": "node tools/icon-view.mjs",
    "icons:site": "node tools/make-favicon.mjs",
    "data:cn": "node tools/fetch-cn-csv.mjs",
    "data:xivapi": "node tools/fetch-xivapi.mjs",
    "data:lodestone": "node tools/fetch-lodestone.mjs",
    "data:build": "node tools/build-data.mjs",
    "data:all": "npm run data:cn && npm run data:xivapi && npm run data:lodestone && npm run data:build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
